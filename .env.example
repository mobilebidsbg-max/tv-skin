# Used by the tvremote Mac CLI and live tests
TV_HOST=192.168.1.16
TV_MAC=00:11:22:33:44:55
# Apple signing team for ios/scripts/install.sh (10 characters). Leave empty to detect it from Xcode.
TV_TEAM_ID=
# Free TMDB key (themoviedb.org → Settings → API) for the Netflix/HBO strip on the TV
TMDB_API_KEY=
