<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Renews the TV Remote iPhone app (free Apple ID = 7 days). Every evening at 20:30; installs only when due.
     Script: ~/Developer/projects/tv-skin/ios/scripts/renew.sh. Remove: launchctl bootout gui/$(id -u) <this file>, then delete it. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dzafirov.tvskin.renew-remote</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/macbookpro/Developer/projects/tv-skin/ios/scripts/renew.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>20</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/macbookpro/Library/Logs/tvskin-renew-remote.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/macbookpro/Library/Logs/tvskin-renew-remote.log</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
